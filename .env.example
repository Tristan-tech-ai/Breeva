# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# APIs
VITE_OPENROUTESERVICE_API_KEY=your_ors_api_key
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key

# Upstash Redis (server-side only - don't expose to client)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# SearchAPI.io (Google Maps POI proxy — server-side only, via api/searchapi)
# Multi-key pool: comma-separated keys are drained sequentially with automatic
# failover when a key's (non-resetting) credits run out — the live-key index is
# persisted in Redis so dead keys aren't re-probed. SEARCHAPI_KEY is the legacy
# single-key fallback, used only when SEARCHAPI_KEYS is unset.
SEARCHAPI_KEYS=key1,key2,key3
SEARCHAPI_KEY=your_searchapi_key

# ============================================
# VAYU Engine — Environment Variables
# ============================================

# --- VAYU MVP (Phase 0) ---
# Open-Meteo: TIDAK perlu API key — API publik
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- VAYU Phase 0.5 ---
TOMTOM_API_KEY=your_tomtom_key
WAQI_TOKEN=your_waqi_token

# --- VAYU Phase 1+ ---
IQAIR_API_KEY=your_iqair_community_key
OPENTOPO_API_KEY=your_opentopography_key

# --- VAYU Phase 2+ ---
CDSE_CLIENT_ID=your_copernicus_client_id
CDSE_CLIENT_SECRET=your_copernicus_secret
NASA_EARTHDATA_TOKEN=your_nasa_token

# ============================================
# Supabase Pro (added 2026-05-15 — Pro upgrade migration)
# ============================================
# These are server-only vars (no VITE_ prefix). The PWA client keeps using
# VITE_SUPABASE_URL via the standard supabase-js client over HTTPS REST.
# These vars are forward-compatible for future direct-Postgres usage
# (migrations CLI, raw pg.Client connections, Prisma/Drizzle, etc.).

# Project reference (e.g., "abcdefghijklmnop"). Used by Supabase CLI + branching.
SUPABASE_PROJECT_REF=your_project_ref

# Transaction-mode pooler URL (Supavisor :6543). Required only if/when
# direct Postgres connections are used from Vercel serverless. Format:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_POOLER_URL=your_pooler_url

# DB password (used by Supabase CLI `supabase link` + pg_dump). NEVER commit
# the real value. Retrieve from Supabase Dashboard → Project Settings → Database.
SUPABASE_DB_PASSWORD=your_db_password

# Shared secret for pg_cron → Vercel webhook auth. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in:
#   1. Vercel project env vars (BREEVA_CRON_SECRET)
#   2. Supabase Vault: SELECT vault.create_secret('<value>', 'vercel_cron_secret');
BREEVA_CRON_SECRET=your_cron_secret_64_hex_chars

# ─── Tier 2 M3 — GNN-PPO sidecar (optional, dark-launch) ───
# 0=disabled (M3 never called), 1=dark-launch (shadow eval, M1 still user-facing),
# 2=user-facing (M3 returned to user; operator_loop sets this on gate met).
GNN_PPO_ENABLED=0
GNN_PPO_SIDECAR_URL=http://localhost:8765
GNN_PPO_MODEL_PATH=D:/breeva-ml-models/routing/ppo_v1.ts.pt
GNN_PPO_VERSION=ppo_v1_seedA_epoch200

# ─── Kaggle multi-account training (optional, M3 only) ─────
# Used by scripts/upload_kaggle_graph_dataset.py + pull_kaggle_ckpts.py to
# coordinate training across 3 Kaggle accounts. See kaggle/README.md.
KAGGLE_USERNAME_A=your_main_account
KAGGLE_USERNAME_B=family_member_1
KAGGLE_USERNAME_C=family_member_2

# ─── Upstash Redis (cache for M2 forecast_route_exposure) ──
# Optional: if both set, forecast_route_exposure results are cached for 15min
# keyed by (polyline_hash + start_hour). Without these, cache is bypassed.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
