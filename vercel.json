{
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/tiles/road/:z/:x/:y", "destination": "/api/vayu/road-aqi?tile=1&z=:z&x=:x&y=:y" },
    { "source": "/api/tiles/road-mvt/:z/:x/:y", "destination": "/api/vayu/road-aqi?mvt=1&z=:z&x=:x&y=:y" },
    { "source": "/api/v1/road-aqi", "destination": "/api/vayu/road-aqi?v1=1" },
    { "source": "/api/v1/route-score", "destination": "/api/vayu/route-score?v1=1" },
    { "source": "/api/v1/exposure", "destination": "/api/vayu/exposure?v1=1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/vayu/road-aqi",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=900, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/tiles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=900, stale-while-revalidate=604800" }
      ]
    }
  ]
}
