# Vercel deploy ignore — uses .gitignore syntax.
#
# IMPORTANT: bare directory patterns (e.g. `vayu/`) match ANY directory with
# that name at ANY depth, NOT just the root. To exclude a specific root dir
# without over-matching a nested subdir of the same name, prefix with `/`:
#
#   vayu/        → matches /vayu/, /api/vayu/, /src/lib/vayu/  (BUG: too broad)
#   /vayu/       → matches /vayu/ ONLY                          (correct)
#
# (2026-05-25: bare `vayu/` previously excluded /api/vayu/ from Vercel build,
# nuking 11 serverless endpoints. Convention now: root-anchor anything intended
# only for the repo root. Bare patterns reserved for truly recursive matches.)
#
# Vercel only needs: api/, src/, public/, package.json, pnpm-lock.yaml,
# vite.config.ts, vercel.json, tsconfig*.json, index.html

# ── ML training artifacts (massive, local-only, ROOT) ──
/mlruns/
/ckpt/
/ckpt_seed*/
/models/
/logs/

# ── Notebook data + outputs (already path-prefixed) ──
/notebooks/data/
/notebooks/.ipynb_checkpoints/

# ── Python workspace (local training, ROOT) ──
# FIX: was bare `vayu/` — over-matched /api/vayu/ + /src/lib/vayu/
/vayu/
/.venv/
/.pytest_cache/
__pycache__/          # bare INTENTIONAL — Python cache appears in any subdir
*.pyc
*.pyo

# ── Safety net for vayu/.venv (5.6 GB local Python virtualenv) ──
# If Vercel CLI doesn't honor the `/vayu/` root-anchor above (CLI 50.x observed
# uploading 5.4 GB despite the rule), this bare pattern catches the venv
# directly. SAFE because:
#   - Matches ONLY a `.venv` subdirectory of any `vayu` dir
#   - There is NO `api/vayu/.venv/` (verified 2026-05-27 audit/A06)
#   - There is NO `src/lib/vayu/.venv/`
#   - Cannot recreate the 2026-05-25 incident (which was bare `vayu/`, matching
#     the parent dir itself, not a specific subdir)
vayu/.venv/

# ── Local scripts (run on Tristan PC, not Vercel, ROOT) ──
/scripts/

# ── Docs (kept in git but not runtime, ROOT) ──
/eve/
/docs/

# ── Build cache (ROOT) ──
/dist/
/.next/
/.turbo/
/.vite/

# ── Untracked dev cache (regeneratable, 516 MB at audit/A06) ──
/cache/

# ── Editor (ROOT) ──
/.vscode/
/.idea/

# ── OS junk (bare INTENTIONAL — appears anywhere) ──
.DS_Store
Thumbs.db

# ── Marker files (transient sentinels, ROOT) ──
/.phase*_complete
/.fallback_safe
/.valhalla_*
/.train_*
/.scheduler_*
/.watchdog_*
/.daemon_pids.json
/.watchdog_trigger.json

# ── Archive (ROOT) ──
/_archive/

# ── Misc test data on D: paths (defensive, ROOT) ──
/breeva-ml-data/
/breeva-valhalla/

# ── Stray dev artifacts at root (per audit/A06 §D2) ──
# These are accidental output dumps from earlier scripts (curl with cwd in
# filename, log capture, etc.). Small individually but should not deploy.
# Pattern format: bare so they match wherever they appear (none in api/ or src/).
.tmp_logs*.txt
STATUS.md
UsersTristanDownloadsbreeva.*.json
